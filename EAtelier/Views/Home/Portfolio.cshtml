@{
    ViewData["Title"] = "Portfolio Project";
}
<h1 class="portfolio-title">@ViewData["Title"]</h1>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="stylesheet" href="~/css/portfotlio.css" asp-append-version="true" />


<div class="portfolio-item">
    <img src="~/images Logo/HuedHands.jpg" alt="HuedHands" class="huedhands">
    <div class="portfolio-description">
        <h4>Hued Hands</h4>
        <p class="c1">ART · CRAFTS · COMMISSIONS</p>
        <p>A creative venture celebrating handmade art and personal expression through <br> hand-painted accessories, customized crafts, and commissioned pieces. <br> Each creation brings a little color and individuality into everyday life.</p>
    </div>
</div>

<div class="portfolio-item">
    <img src="~/images Logo/HrsHrs.jpg"
         alt="Hrs & Hrs"
         class="hrshrs">

    <div class="portfolio-description">
        <h4>Hrs & Hrs</h4>
        <p class="c1">PERFUMERY · HOME FRAGRANCE</p>
        <p>A fragrance brand inspired by the moments and memories that linger. <br> Featuring perfumes, room sprays, linen mists, and everyday scent essentials, <br> Hrs & Hrs brings lasting fragrance to personal spaces and daily rituals.</p>
    </div>
</div>

<div class="portfolio-item">
    <img src="~/images Logo/Cooie.jpg"
         alt="Cooie"
         class="cooie">

    <div class="portfolio-description">
        <h4>Cooie</h4>
        <p class="c1">BAKERY · COFFEE · FOOD PRODUCTS</p>
        <p>A student-founded bakery and coffee venture serving freshly baked cookies, specialty cream buns, <br> and coffee products. Built around accessible treats and comforting flavors, <br> Cooie turns everyday cravings into little moments of happiness..</p>
    </div>
</div>

<div class="portfolio-item">
    <img src="~/images Logo/Fluer de bleu.jpg"
         alt="Fluer de Bleu"
         class="fleurdebleu">

    <div class="portfolio-description">
        <h4>Fluer de Bleu</h4>
        <p class="c1">FLORISTRY · POP-UP FLOWER STAND · CUSTOM BOUQUETS</p>
        <p>A floral venture exploring the two lives of flowers: presence and permanence. <br> From fresh bouquets and personalized floral arrangements to fossilized flowers, <br> Fleur de Bleu creates thoughtful floral pieces for meaningful moments, gifts, and memories..</p>
    </div>
</div>


